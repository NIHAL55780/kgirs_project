# Copy to .env and fill in ONE provider.
# Providers: groq | gemini | openai | openrouter | ollama
LLM_PROVIDER=groq
GROQ_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=

# Optional overrides
# LLM_MODEL=qwen/qwen3.8-27b
# LLM_BASE_URL=
# LLM_TEMPERATURE=0
# MAX_STEPS=8

# paragraphs = BM25 over the 20 paragraphs shipped with each question (default, reproducible)
# wikipedia  = live Wikipedia search
SEARCH_BACKEND=paragraphs
